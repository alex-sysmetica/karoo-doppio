<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools">

  <application>
    <!-- The probe build answers the device questions; it never registers Doppio's ids. -->
    <service
      android:name=".ride.DoppioExtension"
      tools:node="remove" />

    <service
      android:name=".probe.ProbeExtension"
      android:exported="true"
      tools:ignore="ExportedService">
      <intent-filter>
        <action android:name="io.hammerhead.karooext.KAROO_EXTENSION" />
      </intent-filter>
      <meta-data
        android:name="io.hammerhead.karooext.EXTENSION_INFO"
        android:resource="@xml/extension_info" />
    </service>

    <activity
      android:name=".probe.ProbeActivity"
      android:exported="true"
      android:theme="@style/Theme.Doppio">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity>
  </application>
</manifest>
